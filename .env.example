# --- Nango Cloud (https://app.nango.dev) -------------------------------------
# Environment Settings -> API Keys -> secret key. Server-side only.
NANGO_SECRET_KEY=

# Defaults target Nango Cloud; uncomment for a self-hosted Nango (docker compose up).
# NANGO_HOST=http://localhost:3003
# NANGO_CONNECT_URL=http://localhost:3009
# NANGO_PUBLIC_API_URL=http://localhost:3003

# Integration "Unique Key"s from the Nango dashboard. Default = provider name.
# INTEGRATION_GOOGLE_CALENDAR=google-calendar
# INTEGRATION_GOOGLE_MEET=google-meet
# INTEGRATION_GOOGLE_ANALYTICS=google-analytics
# INTEGRATION_ANTHROPIC=anthropic
# INTEGRATION_OPENAI=openai

# Demo identity. Replace with your real logged-in user in production.
# DEMO_USER_ID=demo-user
# DEMO_USER_EMAIL=you@example.com

# Default models shown in the "Ask ..." forms (editable in the UI).
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini
# PORT=3000
